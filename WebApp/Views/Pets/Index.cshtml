@{
}
@model IEnumerable<PetViewModel>

<div class="d-flex justify-content-between align-items-center mb-3 border-bottom pb-2">
    <h5 class="mb-0 fw-semibold">Lost Pets</h5>

    <button class="btn btn-sm btn-outline-danger"
            onclick="PetModalController.openCreateModal()">
        + Report Lost
    </button>
</div>

<div>

    @foreach (var pet in Model)
    {
        var isOwner = pet.IsOwner;

        <div class="pet-row d-flex align-items-center py-2 border-bottom"
             onclick="PetModalController.openEditModal(@pet.PetId, @(isOwner.ToString().ToLower()))">

            <!-- IMAGE -->
            <img src="@(string.IsNullOrEmpty(pet.ImageUrl) ? "/images/no-image.png" : pet.ImageUrl)"
                 class="rounded me-3"
                 style="width:64px;height:64px;object-fit:cover;"
            @* onerror="this.src='/images/no-image.png'" *@ />

            <!-- MAIN INFO -->
            <div class="flex-grow-1">

                <div class="d-flex justify-content-between">
                    <div class="fw-semibold">@pet.Name</div>
                    <div class="text-muted small">
                        @pet.DateLost?.ToShortDateString()
                    </div>
                </div>

                <div class="text-muted small">
                    @pet.Type • @pet.Color
                </div>

                <div class="text-muted small text-truncate" style="max-width: 90%;">
                    @pet.LastSeenAddress
                </div>

                @if (!string.IsNullOrEmpty(pet.Description))
                {
                    <div class="small mt-1 text-truncate" style="max-width: 90%;">
                        @pet.Description
                    </div>
                }
            </div>
        </div>
    }

</div>

<partial name="_CreatePetModal" />


@section Scripts {
    <script src="~/js/petPageController.js"></script>
    <script src="~/js/petModalController.js"></script>
    <script src="~/js/petService.js"></script>
    <script src="~/js/mapService.js"></script>
    <script src="~/js/petFormController.js"></script>
    <script src="~/js/petRenderer.js"></script>
    <script>
        PetPageController.init({
            petService: PetService,
            petModalController: PetModalController,
            mapService: MapService,
            petFormController: PetFormController,
            petRenderer: PetRenderer,
            isAuthenticated: @User.Identity.IsAuthenticated.ToString().ToLower()
        });

        PetModalController.init({
              petService: PetService,
                petFormController: PetFormController,
                mapService: MapService
          });
          
          PetFormController.init({
              petService: PetService,
          });
    </script>
}

