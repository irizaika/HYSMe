@{
}
@model IEnumerable<PetViewModel>

<div class="d-flex justify-content-between align-items-center mb-3 border-bottom pb-2">
    <h5 class="mb-0 fw-semibold">Lost Pets</h5>

    <button class="btn btn-sm btn-outline-danger"
            onclick="PetModule.openCreateModal()"
            data-bs-toggle="modal"
            data-bs-target="#createPetModal">
        + Report Lost
    </button>
</div>

<div>

    @foreach (var pet in Model)
    {
        var isOwner = pet.IsOwner;

        <div class="pet-row d-flex align-items-center py-2 border-bottom"
             onclick="PetModule.openEditModal(@pet.PetId, @(isOwner.ToString().ToLower()))">

            <!-- IMAGE -->
            <img src="@(string.IsNullOrEmpty(pet.ImageUrl) ? "/images/no-image.png" : pet.ImageUrl)"
                 class="rounded me-3"
                 style="width:64px;height:64px;object-fit:cover;"
            @* onerror="this.src='/images/no-image.png'" *@ />

            <!-- MAIN INFO -->
            <div class="flex-grow-1">

                <div class="d-flex justify-content-between">
                    <div class="fw-semibold">@pet.Name</div>
                    <div class="text-muted small">
                        @pet.DateLost?.ToShortDateString()
                    </div>
                </div>

                <div class="text-muted small">
                    @pet.Type • @pet.Color
                </div>

                <div class="text-muted small text-truncate" style="max-width: 90%;">
                    @pet.LastSeenAddress
                </div>

                @if (!string.IsNullOrEmpty(pet.Description))
                {
                    <div class="small mt-1 text-truncate" style="max-width: 90%;">
                        @pet.Description
                    </div>
                }
            </div>

            <!-- ACTION -->
            @* <div class="ms-2">
                @if (isOwner)
                {
                    <button class="btn btn-sm border"
                            onclick="PetModule.openEditModal(@pet.PetId, true)">
                        <i class="bi bi-pencil"></i>
                    </button>
                }
                else
                {
                    <button class="btn btn-sm border"
                            onclick="PetModule.openEditModal(@pet.PetId, false)">
                        <i class="bi bi-eye"></i>
                    </button>
                }
            </div> *@

        </div>
    }

</div>

<partial name="_CreatePetModal" />

@section Scripts {
    <script src="~/js/pets.js"></script>
    <script>
        PetModule.initImagePreview();
    </script>
}

