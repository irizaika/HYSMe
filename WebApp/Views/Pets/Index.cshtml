@{
}
@model PetsPageViewModel
<div class="container-fluid px-3 px-lg-4">
    <div class="d-flex justify-content-between align-items-center py-3 border-bottom">
        <h5 class="mb-0 fw-semibold">Lost Pets</h5>

        <div class="d-flex gap-2">
            <button class="btn btn-sm btn-outline-danger"
                    onclick="LostPetPageController.handleReportClick()">
                + Report Lost
            </button>
        </div>
    </div>

    <div>
        <div class="mt-3 pb-2">
            <input type="text"
                   id="petSearch"
                   class="form-control"
                   placeholder="Search pets..." />
        </div>
    
        <div id="updatePetListContainer" class="pets-layout">
            <partial name="_UpdatePetList" model="Model" />
        </div>

    </div>
</div>

<partial name="_CreatePetModal" />


@section Scripts {
    <script src="~/js/lostPetPageController.js"></script>
    <script src="~/js/petModalController.js"></script>
    <script src="~/js/petService.js"></script>
    <script src="~/js/mapService.js"></script>
    <script src="~/js/petFormController.js"></script>
    <script src="~/js/navigationHelper.js"></script>
    <script>
        PetModalController.init({
            petService: PetService,
            petFormController: PetFormController,
            mapService: MapService
        });
        
        PetFormController.init({
            petService: PetService,
        });

        LostPetPageController.init({
            petModalController: PetModalController,
            navigationHelper: NavigationHelper,
            isAuthenticated: @User.Identity.IsAuthenticated.ToString().ToLower()
        });
 
    </script>
}
